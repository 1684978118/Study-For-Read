# Study For Read Phone deployment environment example.
# Copy this file manually to .env for local deployment experiments.
# Keep real secrets out of git. Replace every change-me value locally.

POSTGRES_DB=study_for_read_example
POSTGRES_USER=study_for_read_example
POSTGRES_PASSWORD=change-me-postgres-password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/study_for_read_example
SPRING_DATASOURCE_USERNAME=study_for_read_example
SPRING_DATASOURCE_PASSWORD=change-me-datasource-password

JWT_SECRET=change-me-user-jwt-secret-at-least-32-bytes
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-at-least-32-bytes

API_BASE_URL=http://api.example.local:8080
WEB_READER_PUBLIC_API_BASE=/api/v1
WEB_ADMIN_PUBLIC_API_BASE=/api/v1

TRANSLATION_PROVIDER=placeholder-provider
TRANSLATION_PROVIDER_API_KEY=change-me-translation-provider-key
TRANSLATION_TEXT_MAX_LENGTH=2000

CORS_ALLOWED_ORIGINS=http://web-reader.example.local,http://web-admin.example.local
