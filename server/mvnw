#!/bin/sh
set -e

MAVEN_VERSION="3.9.9"
WRAPPER_ROOT="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_HOME="${WRAPPER_ROOT}/apache-maven-${MAVEN_VERSION}"
MAVEN_CMD="${MAVEN_HOME}/bin/mvn"

if [ ! -x "${MAVEN_CMD}" ]; then
  mkdir -p "${WRAPPER_ROOT}"
  MAVEN_ZIP="${TMPDIR:-/tmp}/apache-maven-${MAVEN_VERSION}-bin.zip"
  MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${MAVEN_URL}" -o "${MAVEN_ZIP}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "${MAVEN_URL}" -O "${MAVEN_ZIP}"
  else
    echo "curl or wget is required to download Maven." >&2
    exit 1
  fi

  unzip -q -o "${MAVEN_ZIP}" -d "${WRAPPER_ROOT}"
fi

exec "${MAVEN_CMD}" "$@"
